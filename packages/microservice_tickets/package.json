{
  "name": "@quma/microservice_tickets",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "microservice_tickets",
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "packages/microservice_tickets/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "packages/microservice_tickets/src/main.ts",
          "tsConfig": "packages/microservice_tickets/tsconfig.app.json",
          "assets": [
            "packages/microservice_tickets/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/packages/microservice_tickets/dist/package.json",
          "{workspaceRoot}/packages/microservice_tickets/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/packages/microservice_tickets/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "microservice_tickets:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "microservice_tickets:build:development"
          },
          "production": {
            "buildTarget": "microservice_tickets:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@quma/ddd": "workspace:*"
  }
}

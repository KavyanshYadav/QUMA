{
  "/auth/google": {
    "key": "auth:create:withOauth2",
    "path": "/auth/google",
    "method": "POST",
    "description": "Create a new user with OAuth2",
    "auth": ["admin"],
    "meta": {
      "ttl": 30,
      "enabled": true
    }
  },
  "/auth/github": {
    "key": "auth:create:withGithubOauth2",
    "path": "/auth/github",
    "method": "POST",
    "description": "Create a new user with GitHub OAuth2",
    "auth": ["admin"],
    "meta": {
      "ttl": 30,
      "enabled": true
    }
  },
  "/auth/email": {
    "key": "auth:create:withEmail",
    "path": "/auth/email",
    "method": "POST",
    "auth": ["admin"],
    "meta": {
      "enabled": true
    }
  },

  "/event/create": {
    "key": "event:create:withPayload",
    "event": "event:create:event",
    "path": "/event/create",
    "method": "POST",
    "description": "Create a new event with provided data payload",
    "auth": ["admin"],
    "meta": {
      "ttl": 60,
      "enabled": true
    }
  },

  "/event/update": {
    "key": "event:update:details",
    "event": "event:update:event",
    "path": "/event/update",

    "auth": ["admin"],
    "meta": {
      "ttl": 45,
      "enabled": true
    }
  },

  "/event/delete": {
    "key": "event:delete:byId",
    "event": "event:delete:event",
    "path": "/event/delete",
    "method": "DELETE",
    "description": "Delete an existing event using its ID",
    "auth": ["admin"],
    "meta": {
      "ttl": 30,
      "enabled": true
    }
  }

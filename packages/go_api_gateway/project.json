{
  "name": "go_api_gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/go_api_gateway",
  "implicitDependencies": ["@quma/config"],
  "tags": [],
  "targets": {
    "docker": {
      "executor": "@nx-tools/nx-container:build",
      "options": {
        "dockerFile": "packages/go_api_gateway/Dockerfile",
        "buildContext": ".",
        "push": false,
        "tags": ["go_api_gateway:latest", "go_api_gateway:v1.0.0"]
      },
      "dependsOn": ["^build"]
    },
    "build": {
      "executor": "@nx-go/nx-go:build",
      "options": {
        "main": "{projectRoot}/main.go",
        "root": "packages/go_api_gateway"
      },
      "dependsOn": ["^build"]
    },
    "serve": {
      "executor": "@nx-go/nx-go:serve",
      "options": {
        "main": "{projectRoot}/main.go",
        "root": "packages/go_api_gateway"
      }
    },
    "test": {
      "executor": "@nx-go/nx-go:test"
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint"
    }
  }
}

{
  "name": "@quma/config",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "generate-OpenApiRoutes"
        ]
      },
      "generate-OpenApiRoutes": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node ./scripts/generateConfigFromOpenapi.js",
          "cwd": "packages/quma_config"
        }
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.3.0",
    "zod": "^4.1.11"
  }
}
